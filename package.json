{
  "name": "inertia",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "api": "cargo run -p inertia-api",
    "api:release": "cargo run --release -p inertia-api",
    "api:logs": "node scripts/run-native.mjs api-logs",
    "api:stop": "node scripts/run-native.mjs stop-api",
    "api:restart": "node scripts/run-native.mjs stop-api && cargo run -p inertia-api",
    "api:window": "node scripts/run-native.mjs start-api-window",
    "relay": "cargo run -p inertia-relay",
    "vps:ssh": "node scripts/run-native.mjs vps-ssh",
    "web": "npm run dev --prefix apps/web",
    "web:build": "npm run build --prefix apps/web",
    "web:preview": "npm run preview --prefix apps/web -- --host",
    "android:sdk": "node scripts/run-native.mjs setup-android-sdk",
    "android:api:build": "node scripts/run-native.mjs build-android-api",
    "android:package": "node scripts/run-native.mjs package-android",
    "android:open": "node scripts/run-native.mjs android-open",
    "android:apk": "bash scripts/android-tauri-build.sh",
    "android:install": "npm run android:api:build && npm run web:build && npm run android:package && npm run android:apk",
    "android:run": "npm run android:api:build && npm run web:build && npm run android:package && node scripts/run-native.mjs android-run-device",
    "android:run:device": "node scripts/run-native.mjs android-run-device",
    "package:windows": "powershell -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "desktop:package": "node scripts/run-native/desktop.mjs package",
    "desktop:dev": "node scripts/run-native/desktop.mjs dev",
    "desktop:build": "node scripts/run-native/desktop.mjs build"
  }
}
